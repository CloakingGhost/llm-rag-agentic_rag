# 지식베이스 빌드에만 쓰는 운영자 키 (사용자 질문은 각자의 키로 처리한다)
OPENAI_API_KEY=sk-...

# 운영 DB (Neon). 로컬은 docker compose의 postgres를 쓴다.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cdq

# 프론트 도메인만 허용
ALLOWED_ORIGINS=http://localhost:3100

# 관리자 계정 (IMP-10에서 해시로 전환 예정)
ADMIN_ID=admin
ADMIN_PW=admin

# 실행 제한
MAX_CONCURRENT_RUNS=20
RUN_TIMEOUT_SEC=60

# Native RAG 주입 방식: paper(논문 부록 4-B 전량 주입) | compressed(리랭킹 5개)
NATIVE_MODE=paper

# 세션 메모리 상한 (논문 3.4). 프로세스 메모리에만 둔다
SESSION_MAX=500
SESSION_TTL_MIN=120

# 도구 호출·가상 주문 DB (논문 3.5·9.3). 논문 최종 평가와 같이 기본은 꺼 둔다
TOOLS_ENABLED=false
TOOL_MAX_STEPS=3

# 관리자 세션 쿠키. 프런트와 API 도메인이 다르면 none 이어야 한다 (Vercel + Cloud Run)
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# 지식베이스 빌드 (비우면 가장 최근 빌드)
KB_BUILD_ID=

# 지식베이스 빌드에만 쓰는 운영자 키 (사용자 질문은 각자의 키로 처리한다)
OPENAI_API_KEY=sk-...

# 운영 DB (Neon). 로컬은 docker compose의 postgres를 쓴다.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cdq

# 프론트 도메인만 허용
ALLOWED_ORIGINS=http://localhost:3100

# 관리자 계정 (IMP-10에서 해시로 전환 예정)
ADMIN_ID=admin
ADMIN_PW=admin

# 실행 제한
MAX_CONCURRENT_RUNS=20
RUN_TIMEOUT_SEC=60

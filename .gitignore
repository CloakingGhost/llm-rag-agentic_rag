.ruff_cache/

# 노드
node_modules/
.next/
out/
.turbo/

# 환경변수 (키가 들어간다)
.env
.env.local
.env.*.local

# 지식베이스 산출물: 활성 빌드만 저장소에 둔다 (중간 빌드는 로컬에만)
apps/api/kb_artifacts/*
!apps/api/kb_artifacts/kb_20260920_2240/
# 벡터 색인은 용량이 커서 제외한다. Docker 이미지에는 로컬 파일이 그대로 들어간다
apps/api/kb_artifacts/*/chroma/
apps/api/kb_artifacts/*/.tmp/

# OS
Thumbs.db
.DS_Store

# 로컬 개발 DB
apps/api/local_dev.db
# 가상 주문 DB (config/mock_orders.json에서 다시 만들어진다)
apps/api/mock_store.db

# 그래프 추출 체크포인트 (재개용, 재생성 가능)
apps/api/kb_artifacts/*/graph_partial.jsonl

# 배포에 영향력이 없는 폴더
ref/
compare/
deploy/
docs/
agentic_ai_test/


